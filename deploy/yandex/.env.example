# setup.sh создаёт .env автоматически. Этот файл — справка по переменным.

# Домен для HTTPS. По умолчанию <публичный IP>.sslip.io — работает без покупки домена.
DOMAIN=51.250.0.1.sslip.io

# Генерируются случайно: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
OTP_SECRET=

# Как доставлять коды входа:
#   log   — в лог сервера (смотреть: docker compose logs api | grep SMS). Для закрытого теста.
#   smsru — настоящие SMS через sms.ru, нужен SMSRU_API_ID из личного кабинета sms.ru.
SMS_PROVIDER=log
SMSRU_API_ID=
