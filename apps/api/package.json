{
  "name": "@blinkcode/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/db/migrate.ts && tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/jwt": "^9.1.0",
    "@fastify/websocket": "^11.0.2",
    "fastify": "^5.2.0",
    "h3-js": "^4.1.0",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0",
    "ws": "^8.18.0"
  }
}
